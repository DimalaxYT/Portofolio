DATABASE_URL=file:/home/z/my-project/db/custom.db

# ————————————————————————————————————————————————————————————
# Bot de ping automatique (webhook)
# ————————————————————————————————————————————————————————————
# URL du webhook contacté automatiquement à intervalle régulier.
# Exemple Discord : https://discord.com/api/webhooks/123456789/abcdef...
# (Discord → Paramètres du salon → Intégrations → Webhooks → Copier l'URL)
# Fonctionne aussi avec Slack ou tout endpoint acceptant un POST JSON.
# Laisser vide désactive complètement le bot.
PING_WEBHOOK_URL=

# Intervalle entre deux pings, en minutes (défaut : 5).
# Redémarrer le serveur après modification.
PING_INTERVAL_MINUTES=5

# Message personnalisé (optionnel). Par défaut :
# "Ping automatique — le portfolio est en ligne." + date/heure de Paris
# + nombre de réalisations en ligne.
PING_MESSAGE=

# Secret optionnel protégeant /api/bot/ping (utile pour un cron externe).
# À fournir via « Authorization: Bearer <secret> », l'en-tête « x-bot-secret »
# ou « ?secret= ». Les administrateurs connectés au dashboard en sont exemptés.
PING_BOT_SECRET=
