generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Une œuvre du portfolio
model Artwork {
  id          String   @id @default(cuid())
  title       String
  url         String?
  photo       String?
  description String?
  link        String?
  category    String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Paramètres de l'application (mot de passe admin, etc.)
model Setting {
  key   String @id
  value String
}
