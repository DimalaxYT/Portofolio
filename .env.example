# Local development (the directory must exist): mkdir -p .local
# TURSO_DATABASE_URL=file:.local/portfolio.db
# Render: use the URL of a remote Turso database, never file:
TURSO_DATABASE_URL=libsql://your-database-your-organization.turso.io
TURSO_AUTH_TOKEN=

# Bootstrap only, minimum 12 characters. Choose your own unique password.
# Once initialized, the hash and signing secret persist in Turso.
ADMIN_PASSWORD=

# Public production origin, without trailing slash, e.g. https://your-site.onrender.com
# In development it may be left empty (request origin is used).
APP_ORIGIN=
# true on Render only (last X-Forwarded-For address must be set by a trusted proxy)
TRUST_PROXY=false

# Optional webhook. External cron is recommended; see README.
PING_WEBHOOK_URL=
PING_BOT_SECRET=
PING_INTERVAL_MINUTES=5
PING_MESSAGE=
PING_INTERNAL_SCHEDULER=false
